# ============================================================
# Novel2Script AI - 环境变量配置示例
# ------------------------------------------------------------
# 使用方式：
#   1. 复制本文件为 .env （同目录下）
#        Windows:  copy .env.example .env
#        macOS/Linux:  cp .env.example .env
#   2. 把下面的 LLM_API_KEY 换成你自己的 API Key。
#   3. 直接运行 main.py 或命令行，即可自动调用大模型。
#
# 注意：.env 已被 .gitignore 忽略，不会上传到 GitHub，请放心填写。
# ============================================================

# 【必填】大模型 API Key（在这里直接填入你的 key 即可）
LLM_API_KEY=sk-your-api-key-here

# 【可选】OpenAI 兼容接口地址。
#   - OpenAI 官方：       https://api.openai.com/v1
#   - DeepSeek：          https://api.deepseek.com/v1
#   - 通义千问(DashScope)：https://dashscope.aliyuncs.com/compatible-mode/v1
#   - 月之暗面 Kimi：      https://api.moonshot.cn/v1
#   - 智谱 GLM：           https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.deepseek.com/v1

# 【可选】模型名称
#   OpenAI: gpt-4o-mini / gpt-4o
#   DeepSeek: deepseek-chat
#   通义千问: qwen-plus / qwen-max
#   Kimi: moonshot-v1-8k
#   智谱: glm-4-flash / glm-4-plus
LLM_MODEL=deepseek-chat

# 【可选】采样温度（0~1，越低越稳定，剧本结构化建议 0.2~0.4）
LLM_TEMPERATURE=0.3

# 【可选】单次请求最大输出 token
LLM_MAX_TOKENS=4096

# 【可选】每个章节文本送入大模型的最大字符数（过长会被截断以控制成本）
LLM_MAX_CHARS_PER_CHAPTER=6000
